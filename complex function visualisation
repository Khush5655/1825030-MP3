        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Generate points in the complex plane\n",
        "real_axis = np.linspace(-2, 2, 20)\n",
        "imaginary_axis = np.linspace(-2, 2, 20)\n",
        "real_grid, imaginary_grid = np.meshgrid(real_axis, imaginary_axis)\n",
        "complex_grid = real_grid + 1j * imaginary_grid\n",
        "\n",
        "# Apply different complex mappings\n",
        "square_mapping = complex_grid ** 2\n",
        "cube_mapping = complex_grid ** 3\n",
        "exponential_mapping = np.exp(complex_grid)\n",
        "\n",
        "fig, axes = plt.subplots(2, 2, figsize=(10, 8))\n",
        "\n",
        "# Original complex plane\n",
        "axes[0, 0].scatter(real_grid, imaginary_grid)\n",
        "axes[0, 0].set_title(\"Original z-plane\")\n",
        "\n",
        "# Image under z squared\n",
        "axes[0, 1].scatter(square_mapping.real, square_mapping.imag)\n",
        "axes[0, 1].set_title(\"Mapping: w = z²\")\n",
        "\n",
        "# Image under z cubed\n",
        "axes[1, 0].scatter(cube_mapping.real, cube_mapping.imag)\n",
        "axes[1, 0].set_title(\"Mapping: w = z³\")\n",
        "\n",
        "# Image under the exponential function\n",
        "axes[1, 1].scatter(exponential_mapping.real, exponential_mapping.imag)\n",
        "axes[1, 1].set_title(\"Mapping: w = exp(z)\")\n",
        "\n",
        "for axis in axes.flat:\n",
        "    axis.set_xlabel(\"Real part\")\n",
        "    axis.set_ylabel(\"Imaginary part\")\n",
        "    axis.grid(True)\n",
        "\n",
        "fig.tight_layout()\n",
        "plt.show()"
      ]
